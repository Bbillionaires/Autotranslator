# AutoTranslator — environment variables
#
# Copy this file to `.env` and fill in real values for local development. Only the
# variables marked "REQUIRED" must be set for `npm run dev` to boot. Everything else is
# optional/conditional — see the comment on each var. Validation logic lives in
# src/server/env.ts (see docs/implementation-plan.md §6.7 for the full rationale).
#
# This file mirrors every environment variable referenced anywhere in
# docs/implementation-plan.md (translation providers, channel adapters, auth, logging).

# ---------------------------------------------------------------------------
# Core / database (REQUIRED)
# ---------------------------------------------------------------------------

# Postgres connection string used by the Prisma Client at runtime (may point through a
# connection pooler in production). With docker-compose's default dev credentials:
DATABASE_URL="postgresql://autotranslator:autotranslator_dev_password@localhost:5432/autotranslator?schema=public"

# Postgres connection string used for migrations — bypasses any pooler. In local dev this
# is identical to DATABASE_URL (no pooler in front of the docker-compose Postgres).
DIRECT_URL="postgresql://autotranslator:autotranslator_dev_password@localhost:5432/autotranslator?schema=public"

# Auth.js JWT signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Public base URL of the app (used for absolute links, e.g. in magic-link emails and
# webhook registration instructions).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Logging (optional — sensible defaults)
# ---------------------------------------------------------------------------

# One of: fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Translation provider (optional — defaults to a local no-op passthrough provider)
# ---------------------------------------------------------------------------

# One of: openai | google | deepl | noop. Default: noop (echoes input, no external calls —
# safe for local dev/tests with zero API keys configured).
TRANSLATION_PROVIDER="noop"

# CONDITIONAL: required only when TRANSLATION_PROVIDER=openai. The one real, wired-up
# provider (see docs/implementation-plan.md §2.3).
OPENAI_API_KEY=""

# CONDITIONAL: required only when TRANSLATION_PROVIDER=google. Reserved for a future
# GoogleTranslateProvider — not implemented in the MVP.
GOOGLE_TRANSLATE_API_KEY=""

# CONDITIONAL: required only when TRANSLATION_PROVIDER=deepl. Reserved for a future
# DeepLProvider — not implemented in the MVP.
DEEPL_API_KEY=""

# ---------------------------------------------------------------------------
# Email provider (Auth.js magic link) — optional
# ---------------------------------------------------------------------------
# None of these are required to boot: when unset, magic-sign-in links are logged to the
# server console instead of emailed (see src/server/auth.ts). Configure a real transport
# here in a later phase if you want magic links to actually be delivered.

EMAIL_SERVER=""
EMAIL_FROM=""
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Telegram channel adapter — see docs/channel-adapters.md
# ---------------------------------------------------------------------------

# Feature flag. Default: false. When false, the Telegram adapter/routes are not registered
# at all.
TELEGRAM_ENABLED="false"

# REMOVED: TELEGRAM_BOT_TOKEN / TELEGRAM_WEBHOOK_SECRET used to be single, deployment-wide
# credentials here. They no longer exist as env vars — each organization now connects its
# OWN bot (pastes its own bot token from @BotFather) from Settings in the running app; the
# token and a per-organization webhook secret are encrypted at rest on that organization's
# ChannelAccount row (see CREDENTIAL_ENCRYPTION_KEY below). See docs/channel-adapters.md.

# ---------------------------------------------------------------------------
# Android SMS gateway adapter — see docs/channel-adapters.md's "Android SMS gateway" section
# ---------------------------------------------------------------------------

# Feature flag. Default: false.
ANDROID_GATEWAY_ENABLED="false"

# CONDITIONAL: required only when ANDROID_GATEWAY_ENABLED=true. Signs/verifies per-device
# gateway tokens issued at device registration. Unchanged by the per-org credential rewrite
# below — this mechanism already never stored a raw, decryptable secret (only a sha256 hash
# of each issued device token), so it doesn't need CREDENTIAL_ENCRYPTION_KEY to function.
ANDROID_GATEWAY_SIGNING_SECRET=""

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API adapter — see docs/channel-adapters.md
# ---------------------------------------------------------------------------

# Feature flag. Default: false. When false, the WhatsApp adapter/routes are inert (404 /
# no-op).
WHATSAPP_ENABLED="false"

# REMOVED: WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_BUSINESS_ACCOUNT_ID /
# WHATSAPP_VERIFY_TOKEN / WHATSAPP_APP_SECRET used to be single, deployment-wide env vars.
# They no longer exist as env vars — each organization now pastes its OWN WhatsApp Cloud API
# credentials from Settings in the running app; they're encrypted at rest on that
# organization's ChannelAccount row (see CREDENTIAL_ENCRYPTION_KEY below). See
# docs/channel-adapters.md.

# ---------------------------------------------------------------------------
# Per-organization channel credential encryption — see
# src/server/crypto/credentialEncryption.ts
# ---------------------------------------------------------------------------

# CONDITIONAL: required when TELEGRAM_ENABLED, WHATSAPP_ENABLED, or ANDROID_GATEWAY_ENABLED
# is true (never required with every channel flag left false/unset). AES-256-GCM key used
# to encrypt every organization's Telegram bot token / WhatsApp Cloud API credentials at
# rest on ChannelAccount.encryptedCredentials. Must be exactly 32 bytes, hex-encoded (64 hex
# characters). Generate one with: openssl rand -hex 32
# NEVER commit a real value — this is a local-dev/deployment secret, not a template value.
CREDENTIAL_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Internal retry worker — optional but strongly recommended in production
# ---------------------------------------------------------------------------

# Protects GET/POST /api/internal/retry-worker (the endpoint an external scheduler hits
# periodically to drive automatic message retries — see README.md's "Scheduling the retry
# worker in production" section and docs/channel-adapters.md). Not required to boot, but
# the route itself refuses to run (503) if this is unset — there is no insecure fallback.
# Generate one with: openssl rand -hex 32
INTERNAL_WORKER_SECRET=""
